# Copie ce fichier en ".env" et remplis les valeurs.
# NE PARTAGE JAMAIS ton fichier .env (il contient le token du bot).

# Token du bot : https://discord.com/developers/applications > ton app > Bot > Reset Token
DISCORD_TOKEN=

# ID de l'application : onglet "General Information" > Application ID
CLIENT_ID=

# ID de ton serveur Discord (clic droit sur le serveur > Copier l'identifiant, mode développeur activé)
GUILD_ID=
