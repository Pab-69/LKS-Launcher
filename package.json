{
  "name": "lks-launcher",
  "productName": "LKS Launcher",
  "version": "1.25.0",
  "description": "Launcher Assetto Corsa du Lowkey Syndicate : synchro des voitures/circuits, solo, serveurs.",
  "main": "src/main/main.js",
  "author": "Lowkey Syndicate",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "publish-content": "node tools/publish-cli.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "koffi": "^3.3.6",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "com.lowkeysyndicate.launcher",
    "productName": "LKS Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "lks.config.json",
      "package.json",
      "LICENSE",
      "CHANGELOG.md",
      "docs/leaderboard.sql"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "LKS Launcher",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "LKS-Launcher-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pab-69",
        "repo": "lks-launcher",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Pab-69/LKS-Launcher.git"
  },
  "homepage": "https://github.com/Pab-69/LKS-Launcher"
}
