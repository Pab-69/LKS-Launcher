# Image des services Node du serveur LKS (storage, admin, live) : une seule image, une commande par service.
# Contexte de build : la racine du dépôt (on réutilise le même code que le launcher).
FROM node:22-alpine
WORKDIR /app
# client PostgreSQL du service admin (manifeste en base + flux en direct)
RUN npm install --no-audit --no-fund --omit=dev --no-package-lock pg@8.13.1 && npm cache clean --force
COPY server/storage/server.js ./storage.js
COPY server/admin/server.js ./admin.js
COPY src/main/imagemeta.js ./imagemeta.js
COPY src/main/telemetry/championship.js ./championship.js
USER node
CMD ["node", "storage.js"]
